<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="OptionsMenu" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Textures/PauseMenu.jpeg?fileID=2800000&amp;guid=8b9a7903e8edb4cfeb21534df07fe35b&amp;type=3#PauseMenu&quot;); -unity-background-scale-mode: scale-and-crop; background-position-y: center; background-size: cover; -unity-background-image-tint-color: rgb(125, 132, 180); padding-top: 32px; padding-right: 32px; padding-bottom: 32px; padding-left: 32px;">
        <ui:Label text="Sound" name="SoundLabel" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 40px;" />
        <ui:Slider name="MasterSlider" label="Master" value="100" high-value="100" style="color: rgb(255, 255, 255); font-size: 24px;" />
        <ui:Slider name="MusicSlider" label="Music" value="100" high-value="100" style="color: rgb(255, 255, 255); font-size: 24px;" />
        <ui:Slider name="SFXSlider" label="Sound FX" value="100" high-value="100" style="color: rgb(255, 255, 255); font-size: 24px;" />
        <ui:VisualElement name="ScoreContainer" style="flex-grow: 1; justify-content: flex-start; align-items: center; padding-top: 40px;">
            <ui:Label text="High Score" name="ScoreLabel" style="color: rgb(255, 255, 255); font-size: 60px; -unity-font-style: bold;" />
            <ui:Label text="000000" name="Score" style="color: rgb(255, 255, 255); font-size: 48px; padding-top: 16px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
